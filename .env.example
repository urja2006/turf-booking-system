# -------------------------------------------------------------
# TURFBOOK ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# Server Port
PORT=5000

# Supabase Credentials (Optional for local testing, required for cloud Supabase)
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Secret for session signing
JWT_SECRET=turfbook_super_secret_jwt_key_2026

# AI Assistant API Key (Optional - application has built-in smart rule-based NLP fallback)
# OpenAI Key (e.g. sk-...) or Gemini API Key
OPENAI_API_KEY=
GEMINI_API_KEY=
